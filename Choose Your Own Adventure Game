// Press a button to choose your path
// See the README file for more information

/* VARIABLES */
let enterButton;
let a1;
let a2;
let b1;
let b2;
let screen = 0;

/* SETUP RUNS ONCE */
function setup() {
  createCanvas(600, 400);
  textAlign(CENTER);
  textSize(20);
  noStroke();

  // Set up the home screen
  background("pink");
  text(
    "Welcome to The Haunted Cave.",
    width / 2,
    height / 2 - 100
  );

  // Create buttons for all screens
  enterButton = new Sprite(width/2, height/2 + 100);
  a1 = new Sprite(-50, -50);
  a2 = new Sprite(-50, -50);
  b1 = new Sprite(-100, -100);
  b2 = new Sprite(-100, -100);
  b1.collider = "k";
  b2.collider = "k";
    
}

/* DRAW LOOP REPEATS */
function draw() {
  // Display enter button
  enterButton.color = "rgb(205, 122, 235)";
  enterButton.text = "Enter";
  enterButton.w = 100;
  enterButton.h = 50;
  enterButton.collider = "k";
  

  // Add A1 button
  a1.w = 50;
  a1.h = 50;
  a1.collider = "k";
  a1.color = "rgb(205, 122, 235)";

  // Add A2 button

  a2.w = 50;
  a2.h = 50;
  a2.collider = "k";
  a2.color = "rgb(205, 122, 235)";

  // Check enter button
  if (enterButton.mouse.presses()) {
    showScreen1();
  }

  if (screen == 1) {
    if (a1.mouse.presses()) {
      showScreen2();
    } else if (a2.mouse.presses()){
      showScreen5();
    }
  }
  
}

/* FUNCTIONS TO DISPLAY SCREENS */

function showScreen1() {
  background("paleturquoise");
  text("Welcome to Screen 1", width/2, height/2 - 100);
  enterButton.pos = {x: -50, y: -50};

  a1.pos = {x: width/2 - 50, y: height/2 + 100};
  a2.pos = {x: width/2 + 50, y: height/2 + 100};
  screen = 1;
}

function showScreen2() {
  print("Going to display 2");
  print(screen);
  background("plum");
  text("Welcome to Screen 2", width/2, height/2 - 100);
  a1.pos = {x: -150, y: -150};
  a2.pos = {x: -150, y: -150};
  b1.pos = {x: width/2 - 50, y: height/2 + 100};
  b2.pos = {x: width/2 + 50, y: height/2 + 100};
  screen = 2;
}

function showScreen5() {
  print("Going to display 5");
  background("lightblue");
  text("You left on screen 5", width/2, height/2 - 100);
  a1.pos = {x: -150, y: -150};
  a2.pos = {x: -150, y: -150};
  screen = 5;
}

